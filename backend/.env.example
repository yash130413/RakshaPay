# Server
PORT=4000
NODE_ENV=development

# Database (Neon Postgres — use pooler URL with sslmode=require)
# Example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# LLM — Google Gemini (free tier via AI Studio)
# Get key: https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODELS=

# App
FRONTEND_URL=http://localhost:5173
MERCHANT_EMAIL="merchant@example.com"
MERCHANT_NAME="Demo Merchant"
RAZORPAY_NOTIFY_CUSTOMER=true
